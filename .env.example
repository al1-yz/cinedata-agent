# Copie este arquivo para `.env` e preencha. O `.env` NUNCA deve ser versionado
# (ele já está no .gitignore). Valores vazios contam como "não definido".

# Chave do OpenRouter (https://openrouter.ai/keys). Ela começa com sk-or-v1-
OPENROUTER_API_KEY=

# Id do modelo no OpenRouter, no formato provedor/modelo ou provedor/modelo:variante.
# Ainda não há modelo padrão validado: ele será escolhido após os testes reais do marco M2.
CINEDATA_MODEL=

# Até 2 modelos de fallback, separados por vírgula (opcional). Só entram em falhas
# transitórias do provider (limite de uso do provedor, indisponibilidade, erro de conexão).
CINEDATA_FALLBACK_MODELS=

# Caminho do banco SQLite da atividade (relativo à pasta atual ou absoluto).
CINEDATA_DB_PATH=data/cinerocket.db

# Máximo de linhas devolvidas por consulta (1 a 200).
CINEDATA_MAX_ROWS=50

# Tempo máximo de uma consulta SQL, em segundos (1 a 300).
CINEDATA_SQL_TIMEOUT_S=30

# Máximo de requisições ao modelo por pergunta (1 a 20).
# Uma pergunta que consulta o banco usa pelo menos 2; o valor 1 serve a recusas e testes.
CINEDATA_REQUEST_LIMIT=5

# Data de referência para "últimos N anos", no formato AAAA-MM-DD.
# Vazio = data de hoje. Fixe uma data para obter resultados reproduzíveis.
CINEDATA_REFERENCE_DATE=
